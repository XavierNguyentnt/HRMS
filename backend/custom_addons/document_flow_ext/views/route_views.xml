<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Action mở danh sách luồng xử lý -->
  <record id="action_document_route" model="ir.actions.act_window">
    <field name="name">Luồng xử lý văn bản</field>
    <field name="res_model">document.route</field>
    <field name="view_mode">tree,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Tạo và theo dõi luồng xử lý giữa các phòng ban.
      </p>
    </field>
  </record>

  <!-- Giao diện danh sách -->
  <record id="view_document_route_tree" model="ir.ui.view">
    <field name="name">document.route.tree</field>
    <field name="model">document.route</field>
    <field name="arch" type="xml">
      <tree string="Luồng xử lý">
        <field name="document_id"/>
        <field name="from_department_id"/>
        <field name="to_department_id"/>
        <field name="assigned_to"/>
        <field name="status"/>
        <field name="date_sent"/>
        <field name="date_received"/>
      </tree>
    </field>
  </record>

  <!-- Giao diện chi tiết -->
  <record id="view_document_route_form" model="ir.ui.view">
    <field name="name">document.route.form</field>
    <field name="model">document.route</field>
    <field name="arch" type="xml">
      <form string="Chi tiết luồng xử lý">
        <sheet>
          <group>
            <field name="document_id"/>
            <field name="from_department_id"/>
            <field name="to_department_id"/>
            <field name="assigned_to"/>
          </group>
          <group>
            <field name="status"/>
            <field name="date_sent"/>
            <field name="date_received"/>
          </group>
          <field name="note"/>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Thêm menu trong mục Luồng Văn bản -->
  <menuitem
      id="menu_document_route"
      name="Luồng xử lý"
      parent="menu_document_flow_root"
      action="action_document_route"
      sequence="20"
  />
</odoo>
