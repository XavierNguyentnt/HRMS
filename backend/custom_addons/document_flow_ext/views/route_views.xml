<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_route_tree" model="ir.ui.view">
        <field name="name">document.route.tree</field>
        <field name="model">document.route</field>
        <field name="arch" type="xml">
            <list string="Luồng xử lý" editable="bottom">
                <field name="sequence"/>
                <field name="from_department_id"/>
                <field name="to_department_id"/>
                <field name="assigned_to"/>
                <field name="action_type"/>
                <field name="state"/>
                <field name="date_sent"/>
                <field name="date_received"/>
                <field name="processed_date"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_document_route_form" model="ir.ui.view">
        <field name="name">document.route.form</field>
        <field name="model">document.route</field>
        <field name="arch" type="xml">
            <form string="Chi tiết luồng xử lý">
                <sheet>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="action_type"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="from_department_id"/>
                            <field name="to_department_id"/>
                            <field name="assigned_to"/>
                        </group>
                    </group>
                    <group>
                        <field name="date_sent"/>
                        <field name="date_received"/>
                        <field name="processed_date"/>
                    </group>
                    <field name="note" widget="text" placeholder="Ghi chú xử lý..."/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
