<odoo>
  <record id="view_dms_file_form_inherit_document" model="ir.ui.view">
    <field name="name">dms.file.form.inherit.document</field>
    <field name="model">dms.file</field>
    <field name="inherit_id" ref="dms.view_dms_file_form"/>
    <field name="arch" type="xml">
      <sheet position="inside">
        <group string="Thông tin văn bản" colspan="2">
          <field name="ref_no"/>
          <field name="document_type"/>
          <field name="status"/>
          <field name="priority"/>
          <field name="department_id"/>
          <field name="receiver_ids" widget="many2many_tags"/>
          <field name="date_received"/>
          <field name="date_signed"/>
          <field name="summary"/>
        </group>
        <notebook>
          <page string="Luồng xử lý">
            <field name="route_ids">
              <tree editable="bottom">
                <field name="from_department_id"/>
                <field name="to_department_id"/>
                <field name="assigned_to"/>
                <field name="status"/>
                <field name="date_sent"/>
                <field name="date_received"/>
              </tree>
            </field>
          </page>
        </notebook>
      </sheet>
    </field>
  </record>
</odoo>
