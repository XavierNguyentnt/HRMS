<odoo>
  <data>
    <record id="module_category_document_flow" model="ir.module.category">
        <field name="name">Luồng Văn Bản</field>
        <field name="description">Phân quyền cho module Luồng Văn Bản</field>
    </record>

    <record id="group_document_flow_user" model="res.groups">
      <field name="name">Document Flow User</field>
      <field name="category_id" ref="module_category_document_flow"/>
      <field name="implied_ids" eval="[(4, ref('dms.group_dms_user'))]"/>
    </record>

    <record id="group_document_flow_manager" model="res.groups">
      <field name="name">Document Flow Manager</field>
      <field name="category_id" ref="module_category_document_flow"/>
      <field name="implied_ids" eval="[
          (4, ref('group_document_flow_user')),
          (4, ref('dms.group_dms_manager'))
      ]"/>
    </record>

  </data>
</odoo>