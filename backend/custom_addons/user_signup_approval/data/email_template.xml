<odoo>
    <record id="email_template_user_verification" model="mail.template">
        <field name="name">User Verification</field>
        <field name="email_from">${(user.company_id.email or 'noreply@example.com')|safe}</field>
        <field name="subject">Xác thực tài khoản</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="body_html"><![CDATA[
            <p>Xin chào ${object.name},</p>
            <p>Vui lòng nhấn vào link sau để xác thực email:</p>
            <p><a href="http://localhost:8069/api/verify_email/${object.signup_token}">Xác thực email</a></p>
        ]]></field>
    </record>
</odoo>
