<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_registration_whitelist_tree" model="ir.ui.view">
        <field name="name">registration.whitelist.tree</field>
        <field name="model">registration.whitelist</field>
        <field name="arch" type="xml">
            <tree string="Email Whitelist" editable="top">
                <field name="email"/>
                <field name="is_used" readonly="1"/>
                <field name="user_id" readonly="1"/>
            </tree>
        </field>
    </record>

    <record id="view_registration_whitelist_form" model="ir.ui.view">
        <field name="name">registration.whitelist.form</field>
        <field name="model">registration.whitelist</field>
        <field name="arch" type="xml">
            <form string="Whitelist Entry">
                <sheet>
                    <group>
                        <field name="email"/>
                        <field name="is_used"/>
                        <field name="user_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_registration_whitelist" model="ir.actions.act_window">
        <field name="name">Email Whitelist</field>
        <field name="res_model">registration.whitelist</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_registration_whitelist"
              name="Registration Whitelist"
              parent="base.menu_users"
              action="action_registration_whitelist"
              sequence="100"/>
              
    <record id="view_users_form_inherit_approval" model="ir.ui.view">
        <field name="name">res.users.form.inherit.approval</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                 <button name="action_approve_user"
                         type="object"
                         string="Approve User"
                         class="oe_highlight"
                         attrs="{'invisible': [('active', '=', True)]}"/>
            </xpath>
        </field>
    </record>

</odoo>